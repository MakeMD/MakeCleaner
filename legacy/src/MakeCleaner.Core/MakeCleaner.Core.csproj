<Project Sdk="Microsoft.NET.Sdk">

  <!-- All MakeCleaner logic, no UI: neither WinForms nor WPF may be referenced here (a test checks). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MakeCleaner</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="rules\Windows.ini" />
    <EmbeddedResource Include="rules\Windows.ini" LogicalName="Windows.ini" />
    <!-- flows into the output (and publish folder) of every project that references Core -->
    <None Update="rules\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
