<Project>
  <!-- The one place the version lives: both apps' About read it, tools\release.ps1 passes it to the installer. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>MakeCleaner</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
