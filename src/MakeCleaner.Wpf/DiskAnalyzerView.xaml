<UserControl x:Class="MakeCleaner.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- where to look -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Locations" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button x:Name="analyze" DockPanel.Dock="Right" Content="Analyze" Style="{StaticResource Primary}" Margin="8,0,0,0" AutomationProperties.AutomationId="daScan" />
            <Button x:Name="browse" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" />
            <TextBox x:Name="roots" VerticalContentAlignment="Center" AutomationProperties.AutomationId="daRoots" />
        </DockPanel>

        <TextBlock x:Name="status" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="daStatus" />

        <!-- categories as a bar chart (click a bar = its files), files list, actions on the right -->
        <ListBox x:Name="cats" DockPanel.Dock="Left" Width="240" Margin="0,0,12,0" BorderBrush="{StaticResource Line}"
                 HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="daCats">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Height="10" Margin="0,5,0,3">
                            <Border Background="{StaticResource Line}" CornerRadius="2" />
                            <Border Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding Bar}" />
                        </Grid>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- the chart takes the left; actions sit in a row under the files so the list keeps its width -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="open" Content="Open Folder" Margin="0,0,8,0" />
            <Button x:Name="delete" Content="Delete Selected" Margin="0,0,8,0" AutomationProperties.AutomationId="daDelete" />
            <Button x:Name="save" Content="Save Report..." AutomationProperties.AutomationId="daSave" />
        </StackPanel>

        <ListView x:Name="files" BorderBrush="{StaticResource Line}" AutomationProperties.AutomationId="daFiles">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding Size}" />
                    <GridViewColumn Header="Modified" Width="120" DisplayMemberBinding="{Binding Modified}" />
                    <GridViewColumn Header="Folder" Width="420" DisplayMemberBinding="{Binding Folder}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
