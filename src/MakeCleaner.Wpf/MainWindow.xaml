<Window x:Class="MakeCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MakeCleaner" Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="13">
    <DockPanel>
        <!-- footer: version + About -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right">
                    <Hyperlink x:Name="about" AutomationProperties.AutomationId="about">About</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="version" Foreground="{StaticResource Muted}" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- left rail -->
        <DockPanel DockPanel.Dock="Left" Width="92" Background="{StaticResource Rail}">
            <StackPanel DockPanel.Dock="Top" Margin="0,14,0,18" HorizontalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Accent}" HorizontalAlignment="Center">
                    <TextBlock Text="MC" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="MakeCleaner" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" />
            </StackPanel>
            <ListBox x:Name="nav" Style="{StaticResource NavRail}" AutomationProperties.AutomationId="nav" />
        </DockPanel>

        <ContentControl x:Name="host" Margin="16,14,16,12" />
    </DockPanel>
</Window>
