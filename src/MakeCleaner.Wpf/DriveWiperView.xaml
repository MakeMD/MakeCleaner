<UserControl x:Class="MakeCleaner.DriveWiperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Securely erase the free space or the whole contents of a drive." Margin="0,0,0,12" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Wipe" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="mode" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.AutomationId="wipeMode">
                <ComboBoxItem Content="Free Space Only" IsSelected="True" />
                <ComboBoxItem Content="Entire Drive (all data will be erased)" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Security" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="passes" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="wipePasses" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="warning" Foreground="{StaticResource Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="wipeWarning" />
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="cancel" Content="Cancel" IsEnabled="False" Margin="8,0,0,0" DockPanel.Dock="Right" AutomationProperties.AutomationId="wipeCancel" />
                <Button x:Name="wipe" Content="Wipe" Style="{StaticResource Primary}" DockPanel.Dock="Right" AutomationProperties.AutomationId="wipe" />
                <TextBlock x:Name="progress" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="wipeProgress" />
            </DockPanel>
        </StackPanel>

        <ListBox x:Name="drives" BorderBrush="{StaticResource Line}" Padding="4" AutomationProperties.AutomationId="drives" />
    </DockPanel>
</UserControl>
