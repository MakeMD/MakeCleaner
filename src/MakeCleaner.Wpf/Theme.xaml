<!-- MakeCleaner look: every colour, size and control style in one place (a dark theme = another copy of this file).
     Own palette and shapes; only the layout follows the classic cleaner structure (PLAN.md, Stage 2). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#E1E5EA" />
    <SolidColorBrush x:Key="Text" Color="#1D232B" />
    <SolidColorBrush x:Key="Muted" Color="#6A7380" />
    <SolidColorBrush x:Key="Rail" Color="#1F2632" />
    <SolidColorBrush x:Key="RailText" Color="#B9C2CF" />
    <SolidColorBrush x:Key="RailHover" Color="#283141" />
    <SolidColorBrush x:Key="RailSelected" Color="#323D50" />
    <SolidColorBrush x:Key="Accent" Color="#1A9E7A" />
    <SolidColorBrush x:Key="AccentDark" Color="#13826A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E3F4EE" />
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Buttons: flat, 4 px radius; Primary = the one action that changes the disk. -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Tabs above the check trees: plain text, accent underline on the selected one. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" Padding="12,8" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Left rail: icon-over-label tiles, a bar marks the current section. -->
    <Style x:Key="NavRail" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource RailText}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid x:Name="g" Height="68" Background="Transparent">
                                    <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="g" Property="Background" Value="{StaticResource RailHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="g" Property="Background" Value="{StaticResource RailSelected}" />
                                        <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tools / Options sub-menu: flat rows. -->
    <Style x:Key="SubNav" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Width" Value="180" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Padding="14,9" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource Bg}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check trees (Cleaner tabs): group -> items, one CheckNode each; groups show the third state. -->
    <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Focusable="False" Margin="0,2"
                  AutomationProperties.Name="{Binding Label}" Foreground="{StaticResource Text}" />
    </HierarchicalDataTemplate>
    <Style x:Key="CheckTree" TargetType="TreeView">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
        <!-- a few hundred nodes at most; realised items keep UI Automation able to see every group -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
        <Setter Property="ItemTemplate" Value="{StaticResource NodeTemplate}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
