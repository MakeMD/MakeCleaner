<UserControl x:Class="MakeCleaner.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Style="{StaticResource ButtonColumn}">
            <Button x:Name="uninstall" Content="Run Uninstaller" AutomationProperties.AutomationId="uninstallRun" />
            <Button x:Name="repair" Content="Repair" AutomationProperties.AutomationId="uninstallRepair" />
            <Button x:Name="change" Content="Change" AutomationProperties.AutomationId="uninstallChange" />
            <Button x:Name="delete" Content="Delete entry" AutomationProperties.AutomationId="uninstallDelete" />
            <Button x:Name="refresh" Content="Refresh" Margin="0,16,0,8" AutomationProperties.AutomationId="uninstallRefresh" />
            <Button x:Name="save" Content="Save to text file" AutomationProperties.AutomationId="uninstallSave" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="count" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" AutomationProperties.AutomationId="uninstallCount" />
            <TextBox x:Name="search" Padding="4,3" AutomationProperties.AutomationId="uninstallSearch" />
        </DockPanel>

        <!-- a few hundred rows: realised items keep UI Automation able to count them all -->
        <ListView x:Name="list" SelectionMode="Single" BorderBrush="{StaticResource Line}" VirtualizingPanel.IsVirtualizing="False"
                  AutomationProperties.AutomationId="uninstallList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Program" Width="300" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Publisher" Width="190" DisplayMemberBinding="{Binding Publisher}" />
                    <GridViewColumn Header="Installed On" Width="95" DisplayMemberBinding="{Binding Date}" />
                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}" />
                    <GridViewColumn Header="Version" Width="110" DisplayMemberBinding="{Binding Version}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
