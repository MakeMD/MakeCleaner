<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\MakeCleaner.Core\MakeCleaner.Core.csproj" />
    <!-- not referenced, only built first: the no-networking test inspects the apps' own output folders -->
    <ProjectReference Include="..\..\src\MakeCleaner\MakeCleaner.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\MakeCleaner.Wpf\MakeCleaner.Wpf.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\MakeCleaner\bin\$(Configuration)\net10.0-windows\</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WpfAppDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\MakeCleaner.Wpf\bin\$(Configuration)\net10.0-windows\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
